/* ============================================================
   E-COMMERCE CONVERSION FUNNEL ANALYSIS
   Table: dbo.user_events
   Analysis Period: Last 30 days based on latest event date -  (We can change the time period, If needed)
   ============================================================ */


-- ============================================================
-- 0. DATASET
-- ============================================================

SELECT *
FROM dbo.user_events;


-- ============================================================
-- 1. FUNNEL STAGES
-- Page View → Add to Cart → Checkout → Payment → Purchase
-- ============================================================

WITH CleanData AS (
    SELECT
        user_id,
        event_type,
        traffic_source,
        TRY_CONVERT(datetime2, event_date) AS event_datetime
    FROM dbo.user_events
),
FunnelStage AS (
    SELECT
        COUNT(DISTINCT CASE
            WHEN event_type = 'page_view' THEN user_id
        END) AS page_views,

        COUNT(DISTINCT CASE
            WHEN event_type = 'add_to_cart' THEN user_id
        END) AS add_to_cart,

        COUNT(DISTINCT CASE
            WHEN event_type = 'checkout_start' THEN user_id
        END) AS checkout_start,

        COUNT(DISTINCT CASE
            WHEN event_type = 'payment_info' THEN user_id
        END) AS payment_info,

        COUNT(DISTINCT CASE
            WHEN event_type = 'purchase' THEN user_id
        END) AS purchases

    FROM CleanData
    WHERE event_datetime >= DATEADD(
        DAY,
        -30,
        (SELECT MAX(event_datetime) FROM CleanData)
    )
)

SELECT *
FROM FunnelStage;


-- ============================================================
-- 2. FUNNEL CONVERSION RATES
-- ============================================================

WITH CleanData AS (
    SELECT
        user_id,
        event_type,
        TRY_CONVERT(datetime2, event_date) AS event_datetime
    FROM dbo.user_events
),
FunnelStage AS (
    SELECT
        COUNT(DISTINCT CASE
            WHEN event_type = 'page_view' THEN user_id
        END) AS page_views,

        COUNT(DISTINCT CASE
            WHEN event_type = 'add_to_cart' THEN user_id
        END) AS add_to_cart,

        COUNT(DISTINCT CASE
            WHEN event_type = 'checkout_start' THEN user_id
        END) AS checkout_start,

        COUNT(DISTINCT CASE
            WHEN event_type = 'payment_info' THEN user_id
        END) AS payment_info,

        COUNT(DISTINCT CASE
            WHEN event_type = 'purchase' THEN user_id
        END) AS purchases

    FROM CleanData
    WHERE event_datetime >= DATEADD(
        DAY,
        -30,
        (SELECT MAX(event_datetime) FROM CleanData)
    )
)

SELECT
    page_views,

    add_to_cart,

    ROUND(
        add_to_cart * 100.0 /
        NULLIF(page_views, 0),
        2
    ) AS view_to_cart_rate,

    checkout_start,

    ROUND(
        checkout_start * 100.0 /
        NULLIF(add_to_cart, 0),
        2
    ) AS cart_to_checkout_rate,

    payment_info,

    ROUND(
        payment_info * 100.0 /
        NULLIF(checkout_start, 0),
        2
    ) AS checkout_to_payment_rate,

    purchases,

    ROUND(
        purchases * 100.0 /
        NULLIF(payment_info, 0),
        2
    ) AS payment_to_purchase_rate

FROM FunnelStage;


-- ============================================================
-- 3. FUNNEL PERFORMANCE BY TRAFFIC SOURCE
-- ============================================================

WITH CleanData AS (
    SELECT
        user_id,
        event_type,
        traffic_source,
        TRY_CONVERT(datetime2, event_date) AS event_datetime
    FROM dbo.user_events
),
FunnelBySource AS (
    SELECT
        traffic_source,

        COUNT(DISTINCT CASE
            WHEN event_type = 'page_view' THEN user_id
        END) AS page_views,

        COUNT(DISTINCT CASE
            WHEN event_type = 'add_to_cart' THEN user_id
        END) AS add_to_cart,

        COUNT(DISTINCT CASE
            WHEN event_type = 'checkout_start' THEN user_id
        END) AS checkout_start,

        COUNT(DISTINCT CASE
            WHEN event_type = 'payment_info' THEN user_id
        END) AS payment_info,

        COUNT(DISTINCT CASE
            WHEN event_type = 'purchase' THEN user_id
        END) AS purchases

    FROM CleanData
    WHERE event_datetime >= DATEADD(
        DAY,
        -30,
        (SELECT MAX(event_datetime) FROM CleanData)
    )
    GROUP BY traffic_source
)

SELECT
    traffic_source,

    page_views,

    add_to_cart,

    checkout_start,

    payment_info,

    purchases,

    ROUND(
        add_to_cart * 100.0 /
        NULLIF(page_views, 0),
        2
    ) AS view_to_cart_rate,

    ROUND(
        checkout_start * 100.0 /
        NULLIF(add_to_cart, 0),
        2
    ) AS cart_to_checkout_rate,

    ROUND(
        payment_info * 100.0 /
        NULLIF(checkout_start, 0),
        2
    ) AS checkout_to_payment_rate,

    ROUND(
        purchases * 100.0 /
        NULLIF(payment_info, 0),
        2
    ) AS payment_to_purchase_rate,

    ROUND(
        purchases * 100.0 /
        NULLIF(page_views, 0),
        2
    ) AS view_to_purchase_rate

FROM FunnelBySource
ORDER BY view_to_purchase_rate DESC;


-- ============================================================
-- 4. TIME TO CONVERSION
-- View → Cart → Purchase
-- ============================================================

WITH CleanData AS (
    SELECT
        user_id,
        event_type,
        TRY_CONVERT(datetime2, event_date) AS event_datetime
    FROM dbo.user_events
),
UserJourney AS (
    SELECT
        user_id,

        MIN(CASE
            WHEN event_type = 'page_view'
            THEN event_datetime
        END) AS view_time,

        MIN(CASE
            WHEN event_type = 'add_to_cart'
            THEN event_datetime
        END) AS cart_time,

        MIN(CASE
            WHEN event_type = 'purchase'
            THEN event_datetime
        END) AS purchase_time

    FROM CleanData

    WHERE event_datetime >= DATEADD(
        DAY,
        -30,
        (SELECT MAX(event_datetime) FROM CleanData)
    )

    GROUP BY user_id

    HAVING
        MIN(CASE
            WHEN event_type = 'page_view'
            THEN event_datetime
        END) IS NOT NULL

        AND

        MIN(CASE
            WHEN event_type = 'add_to_cart'
            THEN event_datetime
        END) IS NOT NULL

        AND

        MIN(CASE
            WHEN event_type = 'purchase'
            THEN event_datetime
        END) IS NOT NULL
)

SELECT
    COUNT(*) AS converted_users,

    ROUND(
        AVG(
            DATEDIFF(
                MINUTE,
                view_time,
                cart_time
            ) * 1.0
        ),
        2
    ) AS avg_view_to_cart_minutes,

    ROUND(
        AVG(
            DATEDIFF(
                MINUTE,
                cart_time,
                purchase_time
            ) * 1.0
        ),
        2
    ) AS avg_cart_to_purchase_minutes,

    ROUND(
        AVG(
            DATEDIFF(
                MINUTE,
                view_time,
                purchase_time
            ) * 1.0
        ),
        2
    ) AS avg_view_to_purchase_minutes

FROM UserJourney;
